{
  "name": "steamback",
  "version": "1.2.0",
  "description": "中文 Steam 存档备份：按游戏开启、自选路径、固定与备注",
  "scripts": {
    "build": "npm run typecheck && rollup -c",
    "watch": "rollup -c -w",
    "test": "PYTHONPATH=defaults/py_modules python3.11 -m unittest discover -s tests -p \"test_*.py\" -v",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && python3.11 bin/package-plugin.py",
    "test:frontend": "node --test tests/test_frontend.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaochaom/UmeYc-SteamBack.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "plugin-template",
    "steam-deck",
    "deck"
  ],
  "author": "Kevin Hester <kevinh@geeksville.com",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/xiaochaom/UmeYc-SteamBack/issues"
  },
  "homepage": "https://github.com/xiaochaom/UmeYc-SteamBack#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.1",
    "@types/react": "18.3.28",
    "@types/steamid": "^2.0.1",
    "rollup": "^4.57.1",
    "typescript": "^5.9.3",
    "@rollup/plugin-typescript": "^11.1.6"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.5.0",
    "steamid": "^2.0.0",
    "tslib": "^2.8.1"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  },
  "contributors": [
    "xiaochaom"
  ],
  "type": "module"
}
